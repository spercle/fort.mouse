# Comments must be on their own line — a trailing comment becomes part of the pattern.

# Hugo
public/
resources/
.hugo_build.lock

# Photo staging. Files here are raw drops; ingest_photos.py files them into
# static/photos/ where they ARE committed. The README is kept.
incoming/*
!incoming/README.md

# Digitizing scratch: exported GeoJSON, QGIS projects
work/
*.qgz
*.qgd

# Generated by pipeline/build_data.py
data/resolved/
assets/search-index.json

# Generated by pipeline/cc_images.py — but COMMITTED, because regenerating means
# re-fetching from Flickr on every deploy.
# data/credits.yaml
# static/cc/

# Generated by pipeline/thumbnails.py — COMMITTED for the same reason. CI must not
# hammer Orange County's GIS server on every push, and the crops never change.
# static/aerial/
# static/loop-aerial/

# Generated by pipeline/loop_maps.py
static/loop-map/

# Icons ARE committed. Generated by pipeline/icons.py, but small, stable, and
# needed by anyone deploying without running the pipeline first.

# data/reference/ IS committed — it is fetched public-record geometry, slow to
# refetch and stable. Everything above regenerates in under a second from it.

.DS_Store
__pycache__/
*.pyc
