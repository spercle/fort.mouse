{{/* Content Adapter: one page per loop, from data/resolved/. */}}
{{ range $key, $loop := hugo.Data }}
  {{ if and (reflect.IsMap $loop) (isset $loop "loop") }}
    {{ $.AddPage (dict
      "kind" "page"
      "path" (printf "%v" $loop.loop)
      "title" (printf "Loop %v" $loop.loop)
      "slug" (printf "%v" $loop.loop)
      "params" (dict "loop" $loop)
      "content" (dict "mediaType" "text/markdown" "value" "")
    ) }}
  {{ end }}
{{ end }}
